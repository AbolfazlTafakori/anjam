# /etc/anjam/anjam.env  (chmod 600, owned by root)
PORT=8787
BIND=127.0.0.1
ANJAM_DATA=/var/lib/anjam
PUBLIC_URL=https://anjam.abolfazltafakori.com
# Only this e-mail becomes admin (and may sign up even when registration is invite-only/closed).
# Leave empty to make the first account admin instead.
ADMIN_EMAIL=you@example.com
# Default registration mode until the admin changes it in the panel: open | invite | closed
REGISTRATION=invite
# Optional e-mail for password-reset links:
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM=Anjam <no-reply@abolfazltafakori.com>
