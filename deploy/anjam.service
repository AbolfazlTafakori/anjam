# /etc/systemd/system/anjam.service — one static Go binary, its own user, nothing shared with other services.
[Unit]
Description=Anjam server
After=network.target
Documentation=https://github.com/AbolfazlTafakori/anjam

[Service]
Type=simple
User=anjam
Group=anjam
WorkingDirectory=/opt/anjam
EnvironmentFile=/etc/anjam/anjam.env
ExecStart=/opt/anjam/bin/anjam serve
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/anjam
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=256M

[Install]
WantedBy=multi-user.target
