# ══════════════════════════════════════════════
#  MENU: Backup & Restore
# ══════════════════════════════════════════════
menu_backup() {
    while true; do
        header
        section "Backup & Restore"
        show_status
        echo "    [1]  Create immediate backup (Database + Config)"
        echo "    [2]  List existing backups"
        echo "    [3]  Restore database from backup file"
        echo ""
        echo "    [0]  ← Back"
        echo ""
        read -rp "  Choice: " ch || break
        case $ch in
            1)
                mkdir -p "$BACKUP_DIR"
                local stamp; stamp=$(date +%Y%m%d-%H%M%S)
                local db_bak="/tmp/anjam-db-${stamp}.sqlite"
                local out_tar="${BACKUP_DIR}/anjam-backup-${stamp}.tar.gz"

                info "Dumping SQLite database..."
                "$BIN" backup "$db_bak"
                info "Packaging backup archive..."
                tar -czf "$out_tar" -C /tmp "anjam-db-${stamp}.sqlite" -C /etc/anjam anjam.env 2>/dev/null
                rm -f "$db_bak"
                chmod 600 "$out_tar"
                ok "Backup archive created: ${BOLD}${out_tar}${NC}"
                pause ;;
            2)
                echo ""
                info "Existing backups in ${BACKUP_DIR}:"
                mkdir -p "$BACKUP_DIR"
                ls -lh "$BACKUP_DIR" 2>/dev/null || echo "(none)"
                pause ;;
            3)
                echo ""
                read -rp "  Enter full path to backup file (.sqlite or .tar.gz): " bak_file
                if [[ ! -f "$bak_file" ]]; then
                    fail "File does not exist: $bak_file"
                    pause
                    continue
                fi
                read -rp "  Are you sure you want to restore? This overwrites the current database! [y/N]: " conf_res
                if [[ ! "$conf_res" =~ ^[Yy]$ ]]; then
                    warn "Cancelled"
                    pause
                    continue
                fi

                info "Stopping ${SERVICE}..."
                systemctl stop "$SERVICE"
                if [[ "$bak_file" == *.tar.gz ]]; then
                    tar -xzf "$bak_file" -C /tmp/
                    local extracted; extracted=$(ls -t /tmp/anjam-db-*.sqlite 2>/dev/null | head -1)
                    if [[ -n "$extracted" && -f "$extracted" ]]; then
                        cp -f "$extracted" "${DATA_DIR}/app.db"
                        rm -f "$extracted"
                    fi
                else
                    cp -f "$bak_file" "${DATA_DIR}/app.db"
                fi
                chown -R anjam:anjam "${DATA_DIR}/app.db"
                info "Starting ${SERVICE}..."
                systemctl start "$SERVICE"
                ok "Database restored successfully!"
                pause ;;
            0) break ;;
        esac
    done
}

# ══════════════════════════════════════════════
#  MENU: Environment & Settings
# ══════════════════════════════════════════════
menu_settings() {
    while true; do
        header
        section "Environment & Configuration"
        show_status
        echo "    [1]  View current /etc/anjam/anjam.env"
        echo "    [2]  Edit /etc/anjam/anjam.env (nano)"
        echo "    [3]  Change internal port (PORT)"
        echo "    [4]  Configure SMTP Email Settings"
        echo ""
        echo "    [0]  ← Back"
        echo ""
        read -rp "  Choice: " ch || break
        case $ch in
            1)
                echo ""
                if [[ -f "$ENV_FILE" ]]; then
                    cat "$ENV_FILE"
                else
                    warn "Configuration file not found."
                fi
                pause ;;
            2)
                "${EDITOR:-nano}" "$ENV_FILE"
                info "Restarting service to apply changes..."
                set -a; . "$ENV_FILE"; set +a
                systemctl restart "$SERVICE"
                ok "Configuration saved and service restarted"
                pause ;;
            3)
                read -rp "  Enter new internal port [1024-65535]: " new_port
                [[ -z "$new_port" ]] && continue
                sed -i "s|^PORT=.*|PORT=${new_port}|" "$ENV_FILE"
                if [[ -f "$NGINX_SITE" ]]; then
                    sed -i "s|127.0.0.1:[0-9]*|127.0.0.1:${new_port}|g" "$NGINX_SITE"
                    nginx -t && systemctl reload nginx
                fi
                set -a; . "$ENV_FILE"; set +a
                systemctl restart "$SERVICE"
                ok "Port changed to ${new_port} and service reloaded"
                pause ;;
            4)
                echo ""
                echo -e "  ${DIM}SMTP Format: smtp://user:pass@smtp.example.com:587${NC}"
                read -rp "  SMTP URL (leave empty to disable): " smtp_url
                read -rp "  Mail From address (e.g. no-reply@example.com): " mail_from
                sed -i '/^SMTP_URL=/d; /^MAIL_FROM=/d' "$ENV_FILE"
                [[ -n "$smtp_url" ]] && echo "SMTP_URL=${smtp_url}" >> "$ENV_FILE"
                [[ -n "$mail_from" ]] && echo "MAIL_FROM=${mail_from}" >> "$ENV_FILE"
                set -a; . "$ENV_FILE"; set +a
                systemctl restart "$SERVICE"
                ok "SMTP settings updated"
                pause ;;
            0) break ;;
        esac
    done
}

# ══════════════════════════════════════════════
#  MENU: System & Network Optimization (BBR)
# ══════════════════════════════════════════════
menu_optimization() {
    while true; do
        header
        section "Performance & Network (TCP BBR)"
        show_status
        local cc; cc=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo "unknown")
        local qd; qd=$(sysctl -n net.core.default_qdisc 2>/dev/null || echo "unknown")
        echo -e "  Current Congestion Control: ${CYAN}${cc}${NC}"
        echo -e "  Current Default Qdisc:      ${CYAN}${qd}${NC}"
        echo ""
        echo "    [1]  Enable TCP BBR Congestion Control"
        echo "    [2]  Disable TCP BBR (Revert to CUBIC)"
        echo "    [3]  Show Active Sockets & Port Listeners"
        echo ""
        echo "    [0]  ← Back"
        echo ""
        read -rp "  Choice: " ch || break
        case $ch in
            1)
                if [[ "$cc" == "bbr" ]]; then
                    ok "TCP BBR is already active"
                else
                    info "Enabling TCP BBR..."
                    mkdir -p /etc/sysctl.d
                    cat > /etc/sysctl.d/99-bbr-anjam.conf <<EOF
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
EOF
                    sysctl -w net.core.default_qdisc=fq >/dev/null 2>&1
                    sysctl -w net.ipv4.tcp_congestion_control=bbr >/dev/null 2>&1
                    ok "TCP BBR enabled successfully"
                fi
                pause ;;
            2)
                info "Reverting to CUBIC..."
                rm -f /etc/sysctl.d/99-bbr-anjam.conf
                sysctl -w net.core.default_qdisc=pfifo_fast >/dev/null 2>&1
                sysctl -w net.ipv4.tcp_congestion_control=cubic >/dev/null 2>&1
                ok "Reverted to CUBIC"
                pause ;;
            3)
                echo ""
                ss -ltnp | grep -E "anjam|nginx|:${PORT}" || netstat -ltnp 2>/dev/null
                pause ;;
            0) break ;;
        esac
    done
}

# ══════════════════════════════════════════════
#  MENU: Uninstall Anjam
# ══════════════════════════════════════════════
menu_uninstall() {
    header
    section "Uninstall Anjam"
    echo ""
    echo -e "  ${RED}${BOLD}⚠  WARNING: This will remove Anjam from your system:${NC}"
    echo ""
    echo -e "    ${DIM}·${NC} Stop & disable systemd service (${SERVICE})"
    echo -e "    ${DIM}·${NC} Remove Nginx configuration for Anjam"
    echo -e "    ${DIM}·${NC} Remove /opt/anjam and /usr/local/bin/anjam"
    echo -e "    ${DIM}·${NC} ${GREEN}An automated backup will be saved in /root/ first${NC}"
    echo ""
    read -rp "$(echo -e "  ${YELLOW}Also remove SSL certificates for ${PUBLIC_URL}? [y/N]:${NC} ")" RM_SSL
    echo ""
    echo -e "  ${RED}${BOLD}Type 'yes' to proceed with uninstall:${NC}"
    read -rp "  Confirm: " CONF
    [[ "$CONF" != "yes" ]] && warn "Uninstall cancelled" && pause && return

    info "Creating safety backup before removal..."
    local keep="/root/anjam-safety-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
    tar -czf "$keep" --exclude='*.sock' -C / "${DATA_DIR#/}" "${ENV_FILE#/}" 2>/dev/null || true
    chmod 600 "$keep" 2>/dev/null || true
    ok "Safety copy preserved at: ${keep}"

    info "Stopping and disabling service..."
    systemctl stop "$SERVICE" 2>/dev/null || true
    systemctl disable "$SERVICE" 2>/dev/null || true
    rm -f "$SERVICE_FILE"
    systemctl daemon-reload

    info "Removing Nginx configuration..."
    rm -f "$NGINX_LINK" "$NGINX_SITE" /etc/nginx/conf.d/anjam-zones.conf
    nginx -t 2>/dev/null && systemctl reload nginx

    if [[ "$RM_SSL" =~ ^[Yy]$ ]]; then
        local dom="${PUBLIC_URL#https://}"; dom="${dom#http://}"; dom="${dom%%/*}"
        if [[ -n "$dom" ]]; then
            info "Removing SSL certificates for ${dom}..."
            certbot delete --cert-name "$dom" --non-interactive 2>/dev/null || true
        fi
    fi

    info "Cleaning files..."
    rm -rf /opt/anjam /etc/anjam /usr/local/bin/anjam

    echo ""
    ok "Anjam has been successfully uninstalled."
    echo -e "  ${DIM}Data directory kept at ${DATA_DIR} and safety archive in /root/${NC}"
    echo ""
    exit 0
}

